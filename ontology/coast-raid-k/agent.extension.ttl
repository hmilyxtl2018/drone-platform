  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Authorization> ;
  rdfs:range xsd:string ;
  rdfs:comment "授权撤销原因或关联 RevocationEvent。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#requiredHumanControlMode> a owl:DatatypeProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Authorization> ;
  rdfs:range xsd:string ;
