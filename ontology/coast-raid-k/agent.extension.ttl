@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ag: <https://local.ontology/coast-raid-k/agent/1.0.0#> .
@prefix crk: <https://local.ontology/coast-raid-k#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ag: a owl:Ontology ; rdfs:label "coast-raid-k Agent extension"@en ; owl:versionInfo "1.0.0" .

<https://local.ontology/coast-raid-k/agent/1.0.0#Agent> a owl:Class ;
  rdfs:label "作战Agent"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#IndependentContinuant> ;
  rdfs:comment "在环境中接收局部观测、维护信念、形成目标或任务、选择并请求动作且承担可追溯责任的决策主体。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentInstance> a owl:Class ;
  rdfs:label "Agent实例"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:comment "某一次Run中具有生命周期、版本和权限边界的具体Agent。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentFunction> a owl:Class ;
  rdfs:label "Agent责任功能域"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "可组合的作战责任边界：World、Self、Adversary、Options、Gate、Effectors、Learn。功能域不是互斥Agent子类，也不自动授予权限。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#OperationalTimeScale> a owl:Class ;
  rdfs:label "作战时间尺度"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Quality> ;
  rdfs:comment "Agent责任所处时间尺度：Immediate、Tactical、Operational 或 Strategic。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#OrganizationModel> a owl:Class ;
  rdfs:label "组织模型"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "描述Agent类所属组织、编组和指挥关系的模型。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentClass> a owl:Class ;
  rdfs:label "Agent类模型"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "OrgMAS形式 AgentClass=<name,R,G,MO> 的规范化表示，分别由名称、角色集合、目标集合和组织模型构成。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentType> a owl:Class ;
  rdfs:label "Agent类型"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent架构、能力、阶段、状态转移和失败模式的规范；ShellTemplate是其现有项目表示。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentRole> a owl:Class ;
  rdfs:label "Agent角色"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Role> ;
  rdfs:comment "传感、融合、分配、编队、执行、监视和授权等依存角色。角色不是Agent实体。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Organization> a owl:Class ;
  rdfs:label "组织"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#IndependentContinuant> ;
  rdfs:comment "指挥层级、团队或编组；组织成员关系与通信关系分开建模。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#RoleAssignment> a owl:Class ;
  rdfs:label "角色分配"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Relator> ;
  rdfs:comment "把Agent、角色、组织和任务绑定到有效时间的关系实体。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#PlatformBinding> a owl:Class ;
  rdfs:label "平台绑定"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Relator> ;
  rdfs:comment "Agent与物理Platform的时态绑定；Platform不自动等同于Agent。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Observation> a owl:Class ;
  rdfs:label "观测"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent从局部传感器、消息或环境获得的观测；观测不是全局真值。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#BeliefState> a owl:Class ;
  rdfs:label "信念状态"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "某Agent在指定时间窗口内维护的内部信念集合。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#BeliefAssertion> a owl:Class ;
  rdfs:label "信念断言"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "关于实体或命题的一条带来源、置信度和有效时间的断言。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Goal> a owl:Class ;
  rdfs:label "目标"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent或组织期望达到的状态；不等同于已执行的Task。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Task> a owl:Class ;
  rdfs:label "任务"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "可分配、可执行且具有前置条件、截止时间和完成状态的过程。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Plan> a owl:Class ;
  rdfs:label "计划"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "达到Goal或完成Task的步骤、选择条件和资源预算。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Decision> a owl:Class ;
  rdfs:label "决策"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent根据其可见证据、信念、目标和Policy作出的选择；决策不等于动作。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#ActionRequest> a owl:Class ;
  rdfs:label "动作请求"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "请求执行某个Action或请求对该Action进行授权。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Action> a owl:Class ;
  rdfs:label "动作"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "Agent或其Platform实际执行的过程。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Effect> a owl:Class ;
  rdfs:label "效果"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Action造成的状态变化、产品或失败结果。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Message> a owl:Class ;
  rdfs:label "消息"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent之间交换的可验证消息载荷；消息的生产者、接收者和有效时间必须可追溯。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#CommunicationAct> a owl:Class ;
  rdfs:label "通信行为"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "发送、接收、确认或拒绝Message的过程。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Protocol> a owl:Class ;
  rdfs:label "协同协议"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "消息格式、时序、确认和失败语义的规范。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#LinkState> a owl:Class ;
  rdfs:label "链路状态"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Quality> ;
  rdfs:comment "通信通断、延迟、带宽和可见性；不可用链路不能支持共享信念。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Capability> a owl:Class ;
  rdfs:label "能力"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#DependentContinuant> ;
  rdfs:comment "Agent在条件满足时可以提供或执行的能力；能力不等于已经执行。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Policy> a owl:Class ;
  rdfs:label "策略"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "决策、行为和权限约束；包含版本和生效时间。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Authority> a owl:Class ;
  rdfs:label "权限范围"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent可代表的动作、资源和空间范围。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Authorization> a owl:Class ;
  rdfs:label "授权结果"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Policy对ActionRequest的确定性评估结果。现有Permit是项目专用序列化产品，不能由检索结果直接生成。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Run> a owl:Class ;
  rdfs:label "运行"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Occurrent> ;
  rdfs:comment "仿真、演训或任务运行边界；AgentInstance和RuntimeEnvelope必须归属某个Run。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AuditEvent> a owl:Class ;
  rdfs:label "审计事件"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Occurrent> ;
  rdfs:comment "可回放的观察、信念更新、任务、授权、动作和效果事件。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#EmbodiedAgent> a owl:Class ;
  rdfs:label "具身 Agent"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#SoftwareAgent> a owl:Class ;
  rdfs:label "软件 Agent"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Desire> a owl:Class ;
  rdfs:label "愿望/动机"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k/agent/1.0.0#Goal> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Intention> a owl:Class ;
  rdfs:label "意图/承诺"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#StateTransition> a owl:Class ;
  rdfs:label "状态转移"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Resource> a owl:Class ;
  rdfs:label "资源"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#IndependentContinuant> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Constraint> a owl:Class ;
  rdfs:label "约束"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentCycle> a owl:Class ;
  rdfs:label "Agent 周期"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#TimeInterval> a owl:Class ;
  rdfs:label "时间区间"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Occurrent> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#ActionExecution> a owl:Class ;
  rdfs:label "动作执行"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#ProcessSpecification> a owl:Class ;
  rdfs:label "过程规范"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentExecution> a owl:Class ;
  rdfs:label "Agent执行实例"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Process> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AgentState> a owl:Class ;
  rdfs:label "Agent状态"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Quality> ;
  rdfs:comment "Agent扩展术语。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#AssistantSession> a owl:Class ;
  rdfs:label "智能助手会话"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#Occurrent> ;
  rdfs:comment "操作员与智能助手的问答会话；不能直接产生作战事实、信念或授权。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#Operator> a owl:Class ;
  rdfs:label "操作员"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#IndependentContinuant> ;
  rdfs:comment "通过助手查询或提交任务请求的人类主体。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#DecisionDraft> a owl:Class ;
  rdfs:label "决策推荐草案"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "Agent生成的可审查方案推荐；不等同于Decision、Authorization或ActionExecution。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#ApprovalRequest> a owl:Class ;
  rdfs:label "人工审批请求"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "针对ActionRequest的人工在环审查请求；人工批准不直接产生Authorization。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#HumanDecision> a owl:Class ;
  rdfs:label "人工决策"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "操作员对ApprovalRequest作出的可追溯决定；必须由Gate重新评估后才能形成Authorization。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#TriggerDefinition> a owl:Class ;
  rdfs:label "触发器定义"@zh ;
  rdfs:subClassOf <https://local.ontology/coast-raid-k#InformationEntity> ;
  rdfs:comment "声明事件、条件、目标Agent和调度约束的触发器；触发器本身不授予执行权限。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#initiatedBy> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AssistantSession> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#Operator> ;
  rdfs:comment "助手会话由哪个操作员发起；操作员身份不能被助手身份替代。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#representsAgent> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AssistantSession> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:comment "助手会话可选地代表哪个作战 Agent；代表关系不授予授权。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#submitsRequest> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AssistantSession> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#ActionRequest> ;
  rdfs:comment "助手会话提交的动作请求草案；必须经过作战运行时和授权服务。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#realizesType> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AgentInstance> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#AgentType> ;
  rdfs:comment "AgentInstance实现的类型规范。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#usesTemplate> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AgentInstance> ;
  rdfs:range <https://local.ontology/coast-raid-k#ShellTemplate> ;
  rdfs:comment "运行实例采用的现有ShellTemplate；不改变ShellTemplate的既有定义。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#implementedOn> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AgentInstance> ;
  rdfs:range <https://local.ontology/coast-raid-k#Platform> ;
  rdfs:comment "Agent与物理平台的实现绑定。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#performsFunction> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AgentInstance> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#AgentFunction> ;
  rdfs:comment "AgentInstance承担的可组合责任功能域；与 functionDomain 字符串投影保持一致，不等同于权限。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#operatesAtTimeScale> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#AgentInstance> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#OperationalTimeScale> ;
  rdfs:comment "AgentInstance工作的作战时间尺度；与 timeScale 字符串投影保持一致。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#hasRole> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#AgentRole> ;
  rdfs:comment "Agent承担的角色。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#memberOf> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#Organization> ;
  rdfs:comment "Agent的组织成员关系。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#reportsTo> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:comment "指挥或报告关系，不表示通信链路可用。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#hasCapability> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#Capability> ;
  rdfs:comment "Agent可提供的能力。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#observes> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Agent> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#Observation> ;
  rdfs:comment "Agent接收的局部观测。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#updates> a owl:ObjectProperty ;
  rdfs:domain <https://local.ontology/coast-raid-k/agent/1.0.0#Observation> ;
  rdfs:range <https://local.ontology/coast-raid-k/agent/1.0.0#BeliefState> ;
  rdfs:comment "观测更新的信念状态。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#asserts> a owl:ObjectProperty ;
