  rdfs:range xsd:string ;
  rdfs:comment "动作或授权的可逆性：reversible、recoverable 或 irreversible。自主范围只能随可逆性扩大。"@zh .

<https://local.ontology/coast-raid-k/agent/1.0.0#issuedAt> a owl:DatatypeProperty ;
