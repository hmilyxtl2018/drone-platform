{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ontology/coast-raid-k/schema.agent.json",
  "title": "coast-raid-k agent $defs",
  "description": "CORA + BFO Role。页签：型谱 · 能力 · 阶段 · 读写 · 角色 · 禁写。",
  "$defs": {
    "Stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reads",
        "writes"
      ],
      "properties": {
        "name": {
          "enum": [
            "感知",
            "推理",
            "决策",
            "交互",
            "行动"
          ]
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "not": {
            "contains": {
              "const": "Permit"
            }
          }
        }
      }
    },
    "ShellTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bindsPlatformType",
        "stages"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "ShellTemplate"
        },
        "bindsPlatformType": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/Stage"
          }
        },
        "petri": {
          "type": "object"
        }
      },
      "not": {
        "properties": {
          "stages": {
            "contains": {
              "properties": {
                "writes": {
                  "contains": {
                    "const": "Permit"
                  }
                }
              }
            }
          }
        }
      }
    },
    "ShellCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "templates",
        "permitWriter"
      ],
      "properties": {
        "package": {
          "const": "coast-raid-k"
        },
        "permitWriter": {
          "type": "string"
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ShellTemplate"
          }
        }
      }
    }
  }
}
